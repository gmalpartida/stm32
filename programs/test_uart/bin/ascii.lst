   5              	.global atoi
   6              	
   7              	@ Input: r0 = pointer to string (e.g., "999")
   8              	@ Output: r0 = integer value (999)
   9              	atoi:
  10 0000 4FF00001 	    mov r1, #0          @ Result accumulator
  11 0004 4FF00A02 	    mov r2, #10         @ Multiplier
  12              	.Latoi_next_digit:
  13 0008 10F8013B 	    ldrb r3, [r0], #1   @ Load byte and post-increment pointer
  14 000c 002B     	    cmp r3, #0          @ Null terminator?
  15 000e 06D0     	    beq .Ldone_atoi
  16 0010 202B     	    cmp r3, #32         @ Space? (if arguments are space-separated)
  17 0012 04D0     	    beq .Ldone_atoi
  18              	
  19 0014 A3F13003 	    sub r3, r3, #48     @ Convert ASCII '0'-'9' to 0-9
  20 0018 01FB0231 	    mla r1, r1, r2, r3  @ Result = (Result * 10) + digit
  21 001c F4E7     	    b .Latoi_next_digit
  22              	.Ldone_atoi:
  23 001e 0846     	    mov r0, r1
  24 0020 7047     	    bx lr
  25              	
