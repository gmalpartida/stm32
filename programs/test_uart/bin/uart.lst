   1              	.syntax unified
   2              	.cpu cortex-m4
   3              	.thumb
   4              	
   5              	@ definition of vector table
   6 0000 00040020 	.word 0x20000400	@ initialize stack pointer
   7 0004 ED000008 	.word 0x080000ed	@ jump to start of program
   8 0008 00000000 	.space 0xe4			@ reserve this area for remaining of vector table
   8      00000000 
   8      00000000 
   8      00000000 
   8      00000000 
   9              	
  10              		@ enable gpio C clock
  11 00ec 1348     		ldr r0, =RCC_AHBENR
  12 00ee 0168     		ldr r1, [r0]
  13 00f0 41F40021 		orr r1, #(0b0001 << 19)
  14 00f4 0160     		str r1, [r0]
  15              	
  16              		@ enable uart4 clock
  17 00f6 1248     		ldr r0, =RCC_APB1ENR
  18 00f8 0168     		ldr r1, [r0]
  19 00fa 41F40021 		orr r1, #(0b0001 << 19)
  20 00fe 0160     		str r1, [r0]
  21              	
  22              		@ set pins PC10 and PC11 to alternate function mode
  23 0100 1048     		ldr r0, =GPIOC_MODER
  24 0102 0168     		ldr r1, [r0]
  25 0104 41F42001 		orr r1, #(0b1010 << 20)
  26 0108 0160     		str r1, [r0]
  27              	
  28              		@ set uart4 tx, rx as the alternate function for pins PC10 and PC11
  29 010a 0F48     		ldr r0, =GPIOC_AFRH
  30 010c 0168     		ldr r1, [r0]
  31 010e 4FF4AA42 		ldr r2, =(0b0101010100000000)		
  32 0112 41EA0201 		orr r1, r2
  33 0116 0160     		str r1, [r0]	
  34              	
  35              		@ set uart4 baud rate to 9600 bps, oversampling by 16
  36 0118 0C48     		ldr r0, =UART4_BRR
  37 011a 0168     		ldr r1, [r0]
  38 011c 40F24131 		mov r1, #833		@ replace r1 with #833
  39 0120 0160     		str r1, [r0]
  40              	
  41              		@ enable TE, RE and UE
  42 0122 0B48     		ldr r0, =UART4_CR1
  43 0124 0168     		ldr r1, [r0]
  44 0126 41F00101 		orr r1, 0x01	
  45 012a 0160     		str r1, [r0]		@ enable UE
  46 012c 41F00C01 		orr r1, #0b1100
  47 0130 0160     		str r1, [r0]		@ enable TE and RE
  48              	
  49              		@ send a character to host
  50              	
  51 0132 4FF04700 		mov r0, #'G'
  52              		@ldr r1, =UART4_ISR
  53              	@uart4_tx_wait:
ARM GAS  src/uart.asm 			page 2


  54              	@	tst r1, #(1 << 7)
  55              	@	beq uart4_tx_wait
  56 0136 074A     		ldr r2, =UART4_TDR
  57 0138 1070     		strb r0, [r2]
  58              	
  59              	halt:
  60 013a FEE7     		b halt
